            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$sign_out?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace"><prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop></node>

          <!-- Data management -->
          <node oor:name="m10" oor:op="replace">

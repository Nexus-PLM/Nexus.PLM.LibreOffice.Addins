            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Reload Document</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$reload_document?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m44" oor:op="replace"><prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop></node>

          <!-- Settings -->
          <node oor:name="m50" oor:op="replace">

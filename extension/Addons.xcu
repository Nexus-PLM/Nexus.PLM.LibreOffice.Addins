          <node oor:name="m53" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">About Nexus PLM...</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$about?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>

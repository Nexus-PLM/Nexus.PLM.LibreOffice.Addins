          <node oor:name="m25" oor:op="replace"><prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop></node>

          <!-- Workflow -->
          <node oor:name="m30" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">My ~Worklist...</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$worklist?language=Python&amp;location=user:uno_packages</value></prop>

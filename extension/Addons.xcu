<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <!--
    Script URL format, which LibreOffice does not document well and fails on with only a KeyError
    deep inside pythonscript.py:

        vnd.sun.star.script:<oxt file name>|<folder>|<file>.py$<function>?language=Python&location=user:uno_packages

    The first segment is the package name, and pythonscript.py derives that from the LAST element
    of the installed extension's URL — which is the .oxt's own file name, "NexusPLM.oxt". Omit it
    and the lookup raises KeyError; the toolbar still appears, and every button fails the moment it
    is pressed. Renaming the built package therefore breaks every command here.

    The command set is the Word add-in's (docs/COMMANDS.md there), minus Markup and Apply Markups,
    which are about Word's comments and tracked changes, and the Navigator pane. The toolbar carries
    the everyday commands; the menu carries all of them, grouped as the ribbon groups them.

    A script-provider toolbar cannot grey a button by document state. Every command therefore
    stays clickable and explains itself when it cannot run — "This document is not registered in
    PLM." Proper enablement needs a dispatch provider, which is a later piece.
  -->

  <!-- An entity is the wordiest way to say the same thing 24 times, but this is XML. -->
  <node oor:name="AddonUI">

    <node oor:name="OfficeToolBar">
      <node oor:name="com.nexusplm.libreoffice.toolbar" oor:op="replace">

        <node oor:name="t01" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">New</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$new_from_template?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t02" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Open</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$open_from_plm?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t03" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Search</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$search?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t04" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Save</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$save_to_plm?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t05" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Check Out</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_out?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t06" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Check In</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_in?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t07" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Edit Values</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$edit_values?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t08" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Refresh Values</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$refresh_values?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>
        <node oor:name="t09" oor:op="replace">
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Properties</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$properties?language=Python&amp;location=user:uno_packages</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>
        </node>

      </node>
    </node>

    <node oor:name="OfficeMenuBar">
      <node oor:name="com.nexusplm.libreoffice" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Nexus ~PLM</value></prop>
        <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        <prop oor:name="ImageIdentifier" oor:type="xs:string"><value>%origin%/icons/nexus</value></prop>

        <node oor:name="Submenu">

          <!-- Account -->
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Sign In...</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$sign_in?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">

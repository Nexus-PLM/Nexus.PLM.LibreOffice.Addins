            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$save_as_existing?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m16" oor:op="replace"><prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop></node>

          <!-- Tasks -->
          <node oor:name="m20" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Check ~Out</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_out?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m21" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Check ~In...</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_in?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="m22" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Release</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$release?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
